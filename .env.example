# Copy this file to `.env` (gitignored) for local values.
# Loader: backend reads env vars via process.env at startup (Node 20+ `--env-file` or dotenv).
# Never commit a real `.env`.

# Backend (Express API)
PORT=3001
# Frontend origin allowed by CORS (dev Vite server)
FRONTEND_ORIGIN=http://localhost:5173

# n8n instance
N8N_URL=http://localhost:5678
N8N_ANALYZE_PATH=cv-analyze
N8N_JOBS_PATH=cv-jobs
N8N_REWRITE_PATH=cv-rewrite
# Timeout (ms) menunggu webhook n8n; menutupi worst-case rantai failover rewrite
# (5 rewrite + 5 post-check x 60s node timeout = 600000)
N8N_TIMEOUT_MS=600000

# Database
DB_PATH=./data/app.db

# Free models used by the n8n failover chain (dipisah koma; urutan = prioritas failover).
# Cek daftar model gratis terbaru: https://openrouter.ai/models?max_price=0
# Ganti di workflow n8n (node HTTP "Analyze/Rewrite - Model N") agar sesuai daftar ini.
# Catatan (Phase 17): analyze & jobs kini 5 model — gpt-oss-20b:free dihapus (404),
# Model 5 = openrouter/free (auto-router). Semua model: reasoning off + max_tokens 8192.
OPENROUTER_FREE_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-nano-30b-a3b:free,google/gemma-4-31b-it:free,openrouter/free
