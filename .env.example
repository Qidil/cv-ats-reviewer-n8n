# Copy this file to `.env` (gitignored) for local values.
# Loader: backend reads env vars via process.env at startup (Node 20+ `--env-file` or dotenv).
# Never commit a real `.env`.

# Backend (Express API)
PORT=3001

# n8n instance
N8N_URL=http://localhost:5678
N8N_ANALYZE_PATH=cv-analyze
N8N_REWRITE_PATH=cv-rewrite

# Database
DB_PATH=./data/app.db

# Free models used by the n8n failover chain (dipisah koma; urutan = prioritas failover).
# Cek daftar model gratis terbaru: https://openrouter.ai/models?max_price=0
# Ganti di workflow n8n (node HTTP "Analyze/Rewrite - Model N") agar sesuai daftar ini.
OPENROUTER_FREE_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,openai/gpt-oss-120b:free,nvidia/nemotron-3-nano-30b-a3b:free
