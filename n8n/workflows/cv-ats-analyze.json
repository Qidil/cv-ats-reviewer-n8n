        "includeOtherFields": true,
        "assignments": {
          "assignments": [
            {
              "id": "cv-id",
              "name": "cvId",
              "value": "={{ $json.body?.cvId ?? $json.cvId ?? 0 }}",
              "type": "number"
            },
            {
              "id": "cv-text",
              "name": "cvText",
              "value": "={{ $json.body?.cvText ?? $json.cvText ?? \"\" }}",
